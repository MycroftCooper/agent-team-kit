{
  "name": "agent-team-kit",
  "version": "2.0.0-alpha.1",
  "description": "Local web workspace for human-approved plans and external pull-based agents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "atk": "apps/launcher/cli.mjs",
    "atk-agent": "apps/agent-cli/cli.mjs"
  },
  "files": [
    "apps/backend",
    "apps/launcher",
    "apps/agent-cli",
    "apps/web/dist",
    "packages",
    "docs",
    "start.bat",
    "stop.bat",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node apps/launcher/cli.mjs start",
    "dev": "node apps/backend/cli.mjs serve",
    "test": "node scripts/test.mjs",
    "test:workspace": "node scripts/test.mjs",
    "check": "node scripts/check-boundaries.mjs",
    "web:build": "node scripts/build-web.mjs",
    "build": "node scripts/build-web.mjs",
    "smoke": "node scripts/smoke.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:collaboration": "node scripts/collaboration-e2e.mjs",
    "test:desktop": "node scripts/desktop-e2e.mjs",
    "prepack": "node scripts/build-web.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MycroftCooper/agent-team-kit.git"
  },
  "packageManager": "pnpm@11.6.0"
}
