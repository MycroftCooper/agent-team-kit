{
  "schemaVersion": 1,
  "project": "agent-team-kit",
  "language": "en",
  "layout": {
    "flowDir": ".agent-flow",
    "artifactDir": "artifacts/agent-flow",
    "evidenceDir": "artifacts/evidence",
    "tempPrefix": "agent-flow"
  },
  "paths": {},
  "roles": [
    "LEAD",
    "DEV",
    "QA"
  ],
  "functions": {
    "roles": {
      "LEAD": [
        "ORCHESTRATOR"
      ],
      "DEV": [
        "WORKER"
      ],
      "QA": [
        "REVIEWER"
      ]
    },
    "enforceNoSelfReview": true
  },
  "gates": {
    "fast": {
      "parallel": true,
      "groups": {
        "code": [
          "bin/**/*.mjs",
          "lib/**/*.mjs"
        ],
        "tests": [
          "test/**/*.mjs"
        ],
        "docs": [
          "docs/**",
          "*.md"
        ],
        "templates": [
          "templates/**",
          "presets/**",
          "skills/**"
        ],
        "scripts": [
          "scripts/**/*.mjs"
        ],
        "workflow": [
          ".agent-flow/**",
          "agent-flow.config.json",
          "agent-flow.config.schema.json",
          "package.json",
          ".github/**"
        ],
        "plugins": [
          "plugins/**"
        ]
      },
      "steps": [
        {
          "name": "ownership",
          "phase": "preflight",
          "command": [
            "node",
            "bin/atk.mjs",
            "ownership",
            "check"
          ],
          "roleFlag": true,
          "filesFlag": true,
          "when": {
            "changed": true
          }
        },
        {
          "name": "workflow-state",
          "phase": "preflight",
          "command": [
            "node",
            "bin/atk.mjs",
            "state",
            "check"
          ],
          "when": {
            "group": [
              "workflow",
              "docs"
            ]
          }
        },
        {
          "name": "syntax",
          "kind": "syntax",
          "command": [
            "node",
            "--check"
          ],
          "when": {
            "group": [
              "code",
              "tests",
              "scripts"
            ]
          },
          "files": {
            "group": [
              "code",
              "tests",
              "scripts"
            ],
            "mode": "each"
          }
        },
        {
          "name": "unit-tests",
          "kind": "tests",
          "command": [
            "node",
            "scripts/test.mjs"
          ],
          "when": {
            "changed": true
          }
        },
        {
          "name": "plugin-host-selftest",
          "kind": "tests",
          "command": [
            "node",
            "plugins/dsh-agent-board/selftest.mjs"
          ],
          "when": {
            "group": "plugins"
          }
        },
        {
          "name": "plugin-client-selftest",
          "kind": "tests",
          "command": [
            "node",
            "plugins/dsh-agent-board/selftest-client.mjs"
          ],
          "when": {
            "group": "plugins"
          }
        }
      ]
    },
    "quick": {
      "command": [
        "node",
        "scripts/selftest.mjs"
      ]
    },
    "local": {
      "command": [
        "node",
        "scripts/selfhost-verify.mjs"
      ]
    }
  },
  "batch": {
    "manifestTag": "agent-flow-manifest-v1",
    "qaSchemaVersion": 1,
    "idPattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$",
    "allowedPrefixes": [
      "bin",
      "docs",
      "examples",
      "lib",
      "plugins",
      "presets",
      "scripts",
      "skills",
      "templates",
      "test",
      "tools",
      ".agent-flow"
    ],
    "allowRootFiles": true,
    "budgetRounds": 12
  },
  "branch": {
    "development": "main",
    "release": "main",
    "tagPrefix": "v",
    "versionFile": "package.json",
    "gateReport": null,
    "requireCleanTree": true
  },
  "baseline": {
    "roots": [
      "bin",
      "docs",
      "examples",
      "lib",
      "plugins",
      "presets",
      "scripts",
      "skills",
      "templates",
      "test",
      "tools",
      ".agent-flow"
    ]
  },
  "cache": {
    "targets": []
  },
  "board": {
    "title": "Agent Board",
    "port": 1421,
    "compactLimit": 50,
    "fallbackPollMs": 30000
  },
  "plugin": {
    "id": "agent-team-kit-board",
    "route": "/agent-team-kit-board",
    "title": "Agent Board",
    "tabKind": "agentTeamKitBoard",
    "commandId": "agent-team-kit-board.open",
    "dir": "tools/agent-board"
  },
  "import": {
    "stagePatterns": null,
    "typePatterns": null
  },
  "rotation": [],
  "todoSource": null,
  "handoffDoc": null
}
