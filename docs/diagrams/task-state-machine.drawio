<mxfile host="app.diagrams.net"><diagram id="work" name="WORK · 计划子任务"><mxGraphModel adaptiveColors="auto" page="1" pageWidth="1500" pageHeight="1060" grid="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="WORK · 计划子任务" style="text;html=1;align=left;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="25" width="1400" height="40" /></mxCell><mxCell id="subtitle" value="执行、独立评审、返工与最终验收" style="text;html=1;align=left;fontSize=18;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="70" width="1400" height="35" /></mxCell><mxCell id="ready" value="&lt;b&gt;待执行&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;READY&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=19;fillColor=#eef4ff;strokeColor=#8ba9dc;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="230" width="240" height="96" /></mxCell><mxCell id="run" value="&lt;b&gt;执行中&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;RUNNING&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=19;fillColor=#eef4ff;strokeColor=#8ba9dc;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="230" width="240" height="96" /></mxCell><mxCell id="review" value="&lt;b&gt;待评审／评审中&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;REVIEWING&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=19;fillColor=#fff3e3;strokeColor=#ddb36e;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry as="geometry" x="780" y="230" width="240" height="96" /></mxCell><mxCell id="verified" value="&lt;b&gt;已验证&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;VERIFIED&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=19;fillColor=#e7f6ec;strokeColor=#7bb78e;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry as="geometry" x="1140" y="230" width="240" height="96" /></mxCell><mxCell id="cancelled" value="&lt;b&gt;取消&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;CANCELLED&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=19;fillColor=#fdecec;strokeColor=#d69393;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="570" width="240" height="96" /></mxCell><mxCell id="blocked" value="&lt;b&gt;阻塞&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;BLOCKED&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=19;fillColor=#fdecec;strokeColor=#d69393;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="570" width="240" height="96" /></mxCell><mxCell id="done" value="&lt;b&gt;完成&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;DONE&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=19;fillColor=#e7f6ec;strokeColor=#7bb78e;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry as="geometry" x="1140" y="570" width="240" height="96" /></mxCell><mxCell id="e0" value="领取／开始" source="ready" target="run" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="独立评审" source="run" target="review" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="PASS" source="review" target="verified" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="CHANGES_REQUESTED，执行次数 &lt; 3" source="review" target="ready" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="Agent 完成，无独立评审" source="run" target="verified" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="失败／中断&lt;br&gt;租约过期／确认停止" source="run" target="blocked" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" value="评审阻塞／返工次数用尽&lt;br&gt;目标变化／租约过期／确认停止" source="review" target="blocked" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="人工重试" source="blocked" target="ready" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e8" value="计划修订&lt;br&gt;或替换 *" source="ready" target="cancelled" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;dashed=1;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e9" value="HUMAN 显式完成" source="run" target="done" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e10" value="整个计划&lt;br&gt;人工验收" source="verified" target="done" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e11" value="最终验收重校验：归属产物变化 **" source="verified" target="blocked" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e12" value="仅 HUMAN **" source="done" target="blocked" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="notes" value="&lt;b&gt;流转规则与边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;入口：人工批准计划，创建 READY 子任务。领取／开始前要求计划获批、依赖为 VERIFIED 或 DONE、文件锁可用。&lt;br&gt;&lt;br&gt;等待依赖、文件锁、容量或合适身份时仍为 READY。REVIEWING 同时包含等待 Reviewer 领取和实际评审。&lt;br&gt;&lt;br&gt;人工重试要求旧运行已停止、计划仍获批。自动评审返工上限为 3 次执行；人工重试本身没有此次数限制。&lt;br&gt;&lt;br&gt;* 计划修订／替换会将所有非 DONE 的旧 WORK 置为 CANCELLED；须先停止活动或不确定运行，已 DONE 的任务保留。&lt;br&gt;&lt;br&gt;** 整个计划最终验收前，重校验可把受影响的 VERIFIED 或 HUMAN DONE 任务改为 BLOCKED。&lt;br&gt;&lt;br&gt;执行完成须提交合格证据。VERIFIED 已可解锁下游；整个计划验收后 Agent 子任务才变为 DONE。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=16;fillColor=#f8fafc;strokeColor=#dbe3ee;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="800" width="1420" height="245" /></mxCell></root></mxGraphModel></diagram><diagram id="request" name="REQUEST · 需求容器"><mxGraphModel adaptiveColors="auto" page="1" pageWidth="1500" pageHeight="1060" grid="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="REQUEST · 需求容器" style="text;html=1;align=left;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="25" width="1400" height="40" /></mxCell><mxCell id="subtitle" value="规划、人工批准计划、子任务聚合与最终验收" style="text;html=1;align=left;fontSize=18;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="70" width="1400" height="35" /></mxCell><mxCell id="draft" value="&lt;b&gt;草稿／规划／待批准&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;DRAFT&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=19;fillColor=#eef4ff;strokeColor=#8ba9dc;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="230" width="240" height="96" /></mxCell><mxCell id="ready" value="&lt;b&gt;已批准待推进&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;READY&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=19;fillColor=#eef4ff;strokeColor=#8ba9dc;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="230" width="240" height="96" /></mxCell><mxCell id="run" value="&lt;b&gt;推进中&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;RUNNING&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=19;fillColor=#eef4ff;strokeColor=#8ba9dc;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry as="geometry" x="780" y="230" width="240" height="96" /></mxCell><mxCell id="await" value="&lt;b&gt;待人工验收&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;AWAITING_ACCEPTANCE&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=19;fillColor=#fff3e3;strokeColor=#ddb36e;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry as="geometry" x="1140" y="230" width="240" height="96" /></mxCell><mxCell id="blocked" value="&lt;b&gt;阻塞&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;BLOCKED&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=19;fillColor=#fdecec;strokeColor=#d69393;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="570" width="240" height="96" /></mxCell><mxCell id="done" value="&lt;b&gt;完成&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;DONE&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=19;fillColor=#e7f6ec;strokeColor=#7bb78e;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry as="geometry" x="1140" y="570" width="240" height="96" /></mxCell><mxCell id="e0" value="人工批准计划" source="draft" target="ready" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="子任务推进 *" source="ready" target="run" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="全部已验证&lt;br&gt;或完成" source="run" target="await" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="聚合刷新：全部子任务回到 READY" source="run" target="ready" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="聚合刷新：全部子任务 VERIFIED 或 DONE" source="ready" target="await" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="最终产物&lt;br&gt;人工验收" source="await" target="done" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" value="最终验收重校验发现产物变化" source="await" target="blocked" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="人工重试 WORK 子任务" source="blocked" target="run" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e8" value="全部子任务&lt;br&gt;已验证或完成" source="blocked" target="await" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e9" value="规划 Run 租约过期" source="draft" target="blocked" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e10" value="确认规划 Run 已停止" source="blocked" target="draft" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="notes" value="&lt;b&gt;流转规则与边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;入口：人工新建需求 → DRAFT。领取规划、提交计划、计划待批准时，任务仍保持 DRAFT。&lt;br&gt;&lt;br&gt;任何尚未 DONE 的需求，要求修订当前计划后回到 DRAFT；须先停止活动／不确定运行，并取消未完成的旧 WORK。&lt;br&gt;&lt;br&gt;* Agent 子任务开始执行时更新父需求；聚合刷新时，只要有子任务非 READY 就为 RUNNING（已 BLOCKED 的父需求除外）。&lt;br&gt;&lt;br&gt;HUMAN 子任务开始时不立即更新父需求，完成时刷新聚合。子任务 BLOCKED 不直接使父需求 BLOCKED。&lt;br&gt;&lt;br&gt;全部子任务为 VERIFIED 或 DONE 时，创建最终验收并进入 AWAITING_ACCEPTANCE（父需求为 BLOCKED 时也可进入）。&lt;br&gt;&lt;br&gt;REQUEST 不能作为执行任务领取。SUBMITTED、APPROVED 是 Plan 状态；待验收目标失效先改变 Acceptance 状态。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=16;fillColor=#f8fafc;strokeColor=#dbe3ee;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="800" width="1420" height="245" /></mxCell></root></mxGraphModel></diagram><diagram id="bug" name="BUG · 直接修复任务"><mxGraphModel adaptiveColors="auto" page="1" pageWidth="1500" pageHeight="1060" grid="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="BUG · 直接修复任务" style="text;html=1;align=left;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="25" width="1400" height="40" /></mxCell><mxCell id="subtitle" value="无需规划与独立评审，修复后由人工验收" style="text;html=1;align=left;fontSize=18;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="70" width="1400" height="35" /></mxCell><mxCell id="ready" value="&lt;b&gt;待修复&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;READY&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=19;fillColor=#eef4ff;strokeColor=#8ba9dc;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="260" width="240" height="96" /></mxCell><mxCell id="run" value="&lt;b&gt;修复中&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;RUNNING&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=19;fillColor=#eef4ff;strokeColor=#8ba9dc;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry as="geometry" x="500" y="260" width="240" height="96" /></mxCell><mxCell id="await" value="&lt;b&gt;待人工验收&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;AWAITING_ACCEPTANCE&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=19;fillColor=#fff3e3;strokeColor=#ddb36e;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="260" width="240" height="96" /></mxCell><mxCell id="blocked" value="&lt;b&gt;阻塞&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;BLOCKED&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=19;fillColor=#fdecec;strokeColor=#d69393;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry as="geometry" x="500" y="590" width="240" height="96" /></mxCell><mxCell id="done" value="&lt;b&gt;完成&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:15px'&gt;DONE&lt;/font&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=19;fillColor=#e7f6ec;strokeColor=#7bb78e;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="590" width="240" height="96" /></mxCell><mxCell id="e0" value="Worker 领取" source="ready" target="run" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="完成修复并提交产物回执" source="run" target="await" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="失败／中断&lt;br&gt;租约过期／确认停止" source="run" target="blocked" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="人工重试，旧运行已停止" source="blocked" target="ready" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="人工 REJECT，填写原因并返工" source="await" target="ready" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="人工 ACCEPT&lt;br&gt;哈希及文件验证通过、无写锁" source="await" target="done" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#64748b;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="notes" value="&lt;b&gt;流转规则与边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;入口：人工创建 BUG → READY，同时指定 Worker 角色和可写文件范围。BUG 没有 Plan，也不进入 REVIEWING／VERIFIED。&lt;br&gt;&lt;br&gt;等待文件锁、容量或合适 Worker 身份时保持 READY。领取后遵守与 WORK 相同的文件锁和租约规则。&lt;br&gt;&lt;br&gt;租约过期：任务变为 BLOCKED，旧 Run 与文件锁被隔离；必须确认旧执行停止，才可重试。&lt;br&gt;&lt;br&gt;仅请求停止不会立刻改变任务状态；确认停止、过期或提交失败／中断回执后才进入 BLOCKED。&lt;br&gt;&lt;br&gt;验收时文件已变化，会拒绝本次 ACCEPT，任务仍为 AWAITING_ACCEPTANCE；人工 REJECT 可送回修复队列。&lt;br&gt;&lt;br&gt;STOP_REQUESTED／QUARANTINED 属于 Run 状态，不属于任务状态。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=16;fillColor=#f8fafc;strokeColor=#dbe3ee;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="800" width="1420" height="245" /></mxCell></root></mxGraphModel></diagram></mxfile>