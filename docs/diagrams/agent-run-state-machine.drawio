<mxfile host="app.diagrams.net"><diagram id="agent-state-machine" name="Agent · 身份与联系状态"><mxGraphModel adaptiveColors="auto" page="1" pageWidth="1500" pageHeight="1120" grid="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Agent · 身份与联系状态" vertex="1" parent="1" style="text;html=1;align=left;fontSize=30;fontStyle=1;"><mxGeometry as="geometry" x="40" y="25" width="1420" height="45" /></mxCell><mxCell id="subtitle" value="上半部为持久化状态，下半部为按 lastSeen 计算的显示状态" vertex="1" parent="1" style="text;html=1;align=left;fontSize=18;fontColor=#64748b;"><mxGeometry as="geometry" x="40" y="75" width="1420" height="35" /></mxCell><mxCell id="section0" value="数据库写入的状态" vertex="1" parent="1" style="text;html=1;align=left;fontSize=20;fontStyle=1;fontColor=#64748b;"><mxGeometry as="geometry" x="60" y="125" width="1350" height="35" /></mxCell><mxCell id="section1" value="界面显示／最近联系判断（非持久化流转）" vertex="1" parent="1" style="text;html=1;align=left;fontSize=20;fontStyle=1;fontColor=#64748b;"><mxGeometry as="geometry" x="60" y="445" width="1350" height="35" /></mxCell><mxCell id="stored_offline" value="&lt;b&gt;新建／尚未联系&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:17px'&gt;OFFLINE&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=22;fontColor=#1e293b;fillColor=#eef4ff;strokeColor=#8ba9dc;"><mxGeometry as="geometry" x="60" y="225" width="240" height="96" /></mxCell><mxCell id="stored_online" value="&lt;b&gt;已登记联系&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:17px'&gt;ONLINE&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=22;fontColor=#1e293b;fillColor=#e7f6ec;strokeColor=#7bb78e;"><mxGeometry as="geometry" x="600" y="225" width="240" height="96" /></mxCell><mxCell id="stored_revoked" value="&lt;b&gt;已撤销&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:17px'&gt;REVOKED&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=22;fontColor=#1e293b;fillColor=#fdecec;strokeColor=#d69393;"><mxGeometry as="geometry" x="1140" y="225" width="240" height="96" /></mxCell><mxCell id="shown_offline" value="&lt;b&gt;离线／联系已过期&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:17px'&gt;OFFLINE&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=22;fontColor=#1e293b;fillColor=#fff3e3;strokeColor=#ddb36e;"><mxGeometry as="geometry" x="60" y="550" width="240" height="96" /></mxCell><mxCell id="shown_online" value="&lt;b&gt;最近联系&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:17px'&gt;ONLINE&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=22;fontColor=#1e293b;fillColor=#e7f6ec;strokeColor=#7bb78e;"><mxGeometry as="geometry" x="600" y="550" width="240" height="96" /></mxCell><mxCell id="shown_revoked" value="&lt;b&gt;已撤销&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:17px'&gt;REVOKED&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=22;fontColor=#1e293b;fillColor=#fdecec;strokeColor=#d69393;"><mxGeometry as="geometry" x="1140" y="550" width="240" height="96" /></mxCell><mxCell id="e0" value="连接／领取／心跳成功" edge="1" parent="1" source="stored_offline" target="stored_online" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#7b8ca3;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="成功联系，刷新 lastSeen" edge="1" parent="1" source="stored_online" target="stored_online" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#7b8ca3;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="人工撤销身份" edge="1" parent="1" source="stored_online" target="stored_revoked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#7b8ca3;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="人工撤销身份" edge="1" parent="1" source="stored_offline" target="stored_revoked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#7b8ca3;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="联系成功，距今 &lt; 30 秒" edge="1" parent="1" source="shown_offline" target="shown_online" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#7b8ca3;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="距上次联系至少 30 秒" edge="1" parent="1" source="shown_online" target="shown_offline" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#7b8ca3;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" value="revoked = true" edge="1" parent="1" source="shown_online" target="shown_revoked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#7b8ca3;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="revoked = true（优先于联系时间）" edge="1" parent="1" source="shown_offline" target="shown_revoked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#7b8ca3;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="notes" value="入口：createAgent 写入 OFFLINE，lastSeen = null；connect、成功 claim 或 heartbeat 写入 ONLINE，并刷新 lastSeen。&lt;br&gt;&lt;br&gt;超时只影响界面和最近联系判断：没有后台逻辑把数据库 status 自动从 ONLINE 改回 OFFLINE。&lt;br&gt;&lt;br&gt;在线判断：未撤销、lastSeen 非空且距今 &lt; LEASE_MS（30 秒）；建议心跳间隔 HEARTBEAT_MS = 10 秒。&lt;br&gt;&lt;br&gt;撤销会写入 REVOKED，使凭据失效，并对活动 Run 请求停止；已隔离的 Run 保持 QUARANTINED，文件锁不立即释放。&lt;br&gt;&lt;br&gt;没有恢复已撤销身份的入口；需要新建身份。空闲／忙碌按活动 Run 数和 capacity 判断，没有独立的 Agent 状态。&lt;br&gt;&lt;br&gt;ONLINE 表示最近有联系，不保证外部进程仍存活或正在领取任务；角色 ORCHESTRATOR／WORKER／REVIEWER 也不是状态。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=16;fillColor=#f8fafc;strokeColor=#dbe3ee;"><mxGeometry as="geometry" x="40" y="840" width="1420" height="260" /></mxCell></root></mxGraphModel></diagram><diagram id="run-state-machine" name="Run · 单次运行状态机"><mxGraphModel adaptiveColors="auto" page="1" pageWidth="1500" pageHeight="1120" grid="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Run · 单次运行状态机" vertex="1" parent="1" style="text;html=1;align=left;fontSize=30;fontStyle=1;"><mxGeometry as="geometry" x="40" y="25" width="1420" height="45" /></mxCell><mxCell id="subtitle" value="适用于 PLANNING／EXECUTION／REVIEW／HUMAN；每条边的阶段限制见注释" vertex="1" parent="1" style="text;html=1;align=left;fontSize=18;fontColor=#64748b;"><mxGeometry as="geometry" x="40" y="75" width="1420" height="35" /></mxCell><mxCell id="running" value="&lt;b&gt;运行中&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:17px'&gt;RUNNING&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=22;fontColor=#1e293b;fillColor=#eef4ff;strokeColor=#8ba9dc;"><mxGeometry as="geometry" x="60" y="270" width="240" height="96" /></mxCell><mxCell id="stop" value="&lt;b&gt;已请求停止&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:17px'&gt;STOP_REQUESTED&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=22;fontColor=#1e293b;fillColor=#fff3e3;strokeColor=#ddb36e;"><mxGeometry as="geometry" x="550" y="270" width="240" height="96" /></mxCell><mxCell id="quarantine" value="&lt;b&gt;已隔离／待确认&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:17px'&gt;QUARANTINED&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=22;fontColor=#1e293b;fillColor=#fff3e3;strokeColor=#ddb36e;"><mxGeometry as="geometry" x="1050" y="270" width="240" height="96" /></mxCell><mxCell id="completed" value="&lt;b&gt;本次运行完成&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:17px'&gt;COMPLETED&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=22;fontColor=#1e293b;fillColor=#e7f6ec;strokeColor=#7bb78e;"><mxGeometry as="geometry" x="60" y="610" width="240" height="96" /></mxCell><mxCell id="interrupted" value="&lt;b&gt;本次运行中断&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:17px'&gt;INTERRUPTED&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=22;fontColor=#1e293b;fillColor=#fdecec;strokeColor=#d69393;"><mxGeometry as="geometry" x="550" y="610" width="240" height="96" /></mxCell><mxCell id="failed" value="&lt;b&gt;本次运行失败&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:17px'&gt;FAILED&lt;/font&gt;" vertex="1" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontSize=22;fontColor=#1e293b;fillColor=#fdecec;strokeColor=#d69393;"><mxGeometry as="geometry" x="1050" y="610" width="240" height="96" /></mxCell><mxCell id="e0" value="心跳成功，延长租约" edge="1" parent="1" source="running" target="running" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#7b8ca3;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="请求停止／撤销 Agent" edge="1" parent="1" source="running" target="stop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#7b8ca3;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="租约到期，maintenance 隔离运行及文件锁" edge="1" parent="1" source="running" target="quarantine" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#7b8ca3;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="提交计划／评审成功&lt;br&gt;或执行完成回执" edge="1" parent="1" source="running" target="completed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#7b8ca3;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="中断回执 *&lt;br&gt;或评审目标变化" edge="1" parent="1" source="running" target="interrupted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#7b8ca3;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="确认停止&lt;br&gt;或中断回执 *" edge="1" parent="1" source="stop" target="interrupted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#7b8ca3;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" value="确认停止／中断回执 *" edge="1" parent="1" source="quarantine" target="interrupted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#7b8ca3;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="失败回执 *（确认停止写入）" edge="1" parent="1" source="running" target="failed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#7b8ca3;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e8" value="失败回执 *" edge="1" parent="1" source="stop" target="failed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#7b8ca3;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e9" value="失败回执 *" edge="1" parent="1" source="quarantine" target="failed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=15;strokeColor=#7b8ca3;labelBackgroundColor=#ffffff;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="notes" value="入口：createRun 直接创建 RUNNING。终态不复用；任务重试后重新领取会创建新 Run，并递增 generation。&lt;br&gt;&lt;br&gt;PLANNING 提交计划、REVIEW 提交评审成功均为 COMPLETED；评审结论是 CHANGES_REQUESTED／BLOCKED 时也一样。&lt;br&gt;&lt;br&gt;* EXECUTION／HUMAN 的 finishRun 可提交 FAILED 或 INTERRUPTED，须 stopped = true；停止／隔离态也接受此类回执。&lt;br&gt;&lt;br&gt;RUNNING → COMPLETED 要求租约有效；执行完成须证据合格。REVIEW 目标变化会被 invalidateTargets 直接置为 INTERRUPTED。&lt;br&gt;&lt;br&gt;请求停止会保留文件锁；心跳提示停止，不再续租。maintenance 仅隔离 RUNNING，不会把 STOP_REQUESTED 自动改成隔离态。&lt;br&gt;&lt;br&gt;确认停止或执行结束回执会释放运行锁；隔离态不能恢复 RUNNING 或提交完成结果。撤销 Agent 后须由人工确认停止。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=16;fillColor=#f8fafc;strokeColor=#dbe3ee;"><mxGeometry as="geometry" x="40" y="840" width="1420" height="260" /></mxCell></root></mxGraphModel></diagram></mxfile>